{
  "expo": {
    "name": "Station Spark",
    "slug": "station-spark",
    "version": "0.1.0",
    "scheme": "stationspark",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#4FB3F6",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4FB3F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stationspark.app",
      "infoPlist": {
        "UIRequiresFullScreen": true
      }
    },
    "android": {
      "package": "com.stationspark.app",
      "adaptiveIcon": {
        "backgroundColor": "#4FB3F6",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#4FB3F6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
