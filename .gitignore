# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Generated native projects — this app uses Continuous Native Generation.
# `npx expo prebuild` rebuilds ./ios and ./android from app.json every time, so
# they are build output, not source. See docs/NATIVE.md. Nothing under them may
# be hand-edited: write a config plugin instead, or the edit is silently lost.
/ios
/android

# Native build caches, in case a build is ever run from the repo root
/.gradle/
/.cxx/
/local.properties

# reports / scratch
/coverage
/screenshots

# QA harness output — including the throwaway web builds an agent exports to
# drive a screen in a browser. These are 18 MB of Metro output apiece.
/*-dist/
/.*-dist/
/tools/qa/out
/tools/qa/.tmp
/tools/qa/out2
# …and the before/after sheets an art agent shoots to check its own work.
# Megabytes of PNG that describe a moment, not the app.
/tools/qa/before-*
/tools/qa/wip*
/tools/qa/after-*

# one-off scratch drivers a harness run leaves behind
*.tmp.mjs
/.qa-*.mjs
*.local.mjs
